# Required: the ID from https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Speed Tests

# Local development: point to a downloaded service-account JSON file.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# Alternative for a secret manager or hosting platform: put the complete
# service-account JSON object on one line. Do not set both options.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional Trello integration. Leave blank to record only in Google Sheets.
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# Configurable readiness rules.
MIN_DOWNLOAD_MBPS=15
MIN_UPLOAD_MBPS=8
MAX_LATENCY_MS=120
MAX_JITTER_MS=30

# Comma-separated list of origins allowed to call this API from the browser.
# Required if a front end hosted elsewhere (e.g. a Lovable-hosted site) will
# POST to /api/submissions. Defaults to the Lawline Lovable site + localhost
# if left blank.
ALLOWED_ORIGINS=https://lawlinepresentercheck.lovable.app
